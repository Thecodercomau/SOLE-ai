FLASK_SECRET_KEY=replace-me

# Concept generation (Groq)
GROQ_API_KEY=

# Captcha — use your own hCaptcha keys; the defaults only work with hCaptcha's test keys
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Image generation
# Comma-separated provider order, first success wins: pollinations, huggingface
IMAGE_PROVIDERS=pollinations,huggingface

# Hugging Face Inference Providers (needs credits on the account)
HF_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional Pollinations pollen key (lifts the free 1 image / 45s limit)
POLLINATIONS_TOKEN=
